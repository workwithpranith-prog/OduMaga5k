{
  "name": "odu-maga",
  "private": true,
  "description": "Blocky 3D runs around Bengaluru. Static site: open index.html, no build step.",
  "scripts": {
    "format": "prettier --write \"*.html\" \"css/**/*.css\" \"js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"*.html\" \"css/**/*.css\" \"js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.mjs\"",
    "lint": "node tools/lint.mjs",
    "test": "playwright test",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "prettier": "3.10.1",
    "three": "0.128.0"
  }
}
